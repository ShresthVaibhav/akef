{"code": 0, "message": "OK", "data": {"catalog": [{"id": "1", "name": "Endfield Database", "status": 2, "position": 1, "typeSub": [{"id": "2", "name": "Weapons", "fatherTypeId": "1", "style": 2, "status": 2, "position": 2, "icon": "", "items": [{"itemId": "1283", "name": "Lunar Calling", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20261109/3864465401225/6af129d2e81005d4616ebcea_56331367.png", "name": "Lunar Calling", "description": null, "associate": {"id": "2f9804247b479e029c6b702bf07741a0", "name": "", "type": "weapon", "dotType": "label_type_up"}, "dotType": "label_type_up", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10210"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10210"], "publishedAtTs": "1791859102", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A symbolic masterpiece of Hongshan Swordmancers. The weapon is constructed using the latest metal smelting technologies and forged with ancient Yanese sword-forging techniques. The result features both excellent performance and time-tested beauty."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1282", "name": "Complexed Industry", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20261021/3864465401225/6ad80a97be8f5e266368426d_56331367.png", "name": "Complexed Industry", "description": null, "associate": {"id": "92d230e244e5a1ecdda47603e9cdffec", "name": "", "type": "weapon", "dotType": ""}, "dotType": "label_type_new", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10210"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10210"], "publishedAtTs": "1791859107", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "An all-new product from the Northmarch Support Hub \"Pioneer\" series. Furnished with an excellent power component, it can easily cut down thick vegetation to clear a path. The weapon is highly recommended by many explorers."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1281", "name": "Long Heritage", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20261016/6743194780021/6ad21bb4a03f3aa857d1fc4f_3eac6ad0.png", "name": "Long Heritage", "description": null, "associate": {"id": "867c8533a7d696903de9e686ee07e0ac", "name": "", "type": "weapon", "dotType": ""}, "dotType": "label_type_new", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10209"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10209"], "publishedAtTs": "1791859111", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "An excellent example of RAYTHEAN customized solutions. The weapon features the designer's applications of novel alloys. The client's customization requirements have been achieved through its complex yet symmetrical structure."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1280", "name": "Jade Vessel", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20261016/6743194780021/6ad21619be8f5e2663682521_3eac6ad0.png", "name": "Jade Vessel", "description": null, "associate": {"id": "d24fe31909793faf478670f89da000eb", "name": "", "type": "weapon", "dotType": ""}, "dotType": "label_type_up", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10209"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10209"], "publishedAtTs": "1791859114", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A special greatsword produced by Hongshan Swordmancers. It is constructed using special materials and resembles a special jade instrument used in ancient Yanese rituals. The weapon is massive, yet is surprisingly light and allows its wielder to unleash a devastating flurry of attacks."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1176", "name": "Dessert Moment", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260924/7192618399447/6ab4debdbe8f5e266367be34_13673ac9.png", "name": "Dessert Moment", "description": null, "associate": {"id": "7ccac9f57507312eba260be031ba94cc", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10005"}, {"subTypeId": "10207", "value": "10210"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10005", "10210"], "publishedAtTs": "1790235217", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A unique work released by the Portable Æthertech Labs. The designs are supposedly inspired by a medical center that the fine artist visited. The construction is bold and uses avant-garde materials. The product carries a keen edge for satisfying any gastronomic ... or combat needs."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1175", "name": "Umbra of Frigid Eventide", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260905/7040428526148/6a9bb4335e88149e6fd82955_56331367.png", "name": "Umbra of Frigid Eventide", "description": null, "associate": {"id": "4e7f3757fd7c98a1262bf4bca8fd9d83", "name": "", "type": "weapon", "dotType": ""}, "dotType": "label_type_up", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10211"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10211"], "publishedAtTs": "1788417338", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A weapon forged by Fort Forgefane. Housed in a sleek streamlined chassis with a special coating designed for combat operations in poorly-lit environments."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1177", "name": "Suffering's End", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260914/7040428526148/6aa70e48e6c4787f27a28276_13673ac9.png", "name": "Suffering's End", "description": null, "associate": {"id": "f010f867eed6879bffa930786e956841", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10211"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10211"], "publishedAtTs": "1788417342", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "One of the strange Arts Units from Witching Hour. It seems to be imbued with a rather odd form of Originium Arts that gives the wielder an unfathomable sense of safety."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1046", "name": "Bedazzling Night Debut", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260812/6743194780021/6a7c6bf8e9384335dcb212a8_f1525633.png", "name": "Bedazzling Night Debut", "description": null, "associate": {"id": "1a6060918f5c1ad9182b2c915f568b90", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10212"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10212"], "publishedAtTs": "1786540870", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A top-of-the-line product series from Mieszko Industries, tailor-made to order for popular thespians of the performing arts. The dreamy and conspicuously loud microphone-like design is coupled with extraordinary performance and power. This weapon has left quite an impression on every tester who tried it out."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1045", "name": "Type 42: Solemn Phalanx", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260716/7192618399447/6a5898f3337a11068196bfee_2f76db19.png", "name": "Type 42: Solemn Phalanx", "description": null, "associate": {"id": "10401d3e48a98592c90191125ad3fa5f", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10211"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10211"], "publishedAtTs": "1784189103", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A set of standard Arts Units designed and developed by the Hongshan Swordmancers. These weapons are currently issued to members of the Yinglung Special Task Force. They are known for their excellent performance and stability, as well as their reliability in unforgiving environments."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1044", "name": "Golden Age", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260719/6743194780021/6a5c7b099650be734250263d_db193eac.png", "name": "Golden Age", "description": null, "associate": {"id": "beb7eb1f8c1e41ab79a5a6d021a76631", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10212"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10212"], "publishedAtTs": "1784490558", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "One of the top-end products of Mieszko Industries. The tip of the lance is constructed using a special alloy that features incredible toughness and razor-sharp edges. Such weapons are elegant, sublime, and incredibly expensive to make, and are usually wielded by individuals who wish to highlight their prestige."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1043", "name": "Junction Point", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260716/7192618399447/6a58a8a0337a11068196c09d_3eac6ad0.png", "name": "Junction Point", "description": null, "associate": {"id": "5f324d7f954a744c2ae04db6a8d8aa62", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10211"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10211"], "publishedAtTs": "1784189099", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "Based on a winning entry of a concept design competition organized by Mieszko Industries. Projectile acceleration with microsecond-scale precision and outstanding hovering performance are features made possible by incorporating the designer's unique understanding of zero gravity environments."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1042", "name": "Farsight", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260716/6743194780021/6a58c74d337a11068196c206_3eac6ad0.png", "name": "Farsight", "description": null, "associate": {"id": "f5d3458d700506ab2a57bc38aa4f3f65", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10210"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10210"], "publishedAtTs": "1784259964", "caption": [{"color": "light_text_primary", "kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"color": "light_text_primary", "kind": "text", "text": {"text": "One of the many prototypes manufactured by Endfield Industries for testing out various specifications. This weapon was intended as a general-purpose platform constructed using high-end materials. It is a vessel of hope for the arsenal engineers of Endfield Industries."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1032", "name": "Blessing of Lustrous Carmine", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260910/3864465401225/6aa266435e88149e6fd8432b_6ad0f152.png", "name": "Blessing of Lustrous Carmine", "description": null, "associate": {"id": "798724f8378cee6f02e8373ff117bb3e", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10212"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10212"], "publishedAtTs": "1782484314", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "One of the polearms produced by the Witching Hour. A special commemorative edition was released on Seš'qa Open Day. The body of the lance underwent a special plating technique to provide a finish that is both extremely functional and aesthetically pleasing."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1001", "name": "Amaranthine Tassel", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260605/2452982252316/6a2257dc337a110681960cc3_56331367.png", "name": "Amaranthine Tassel", "description": null, "associate": {"id": "235fba8ef752b32a7534e1c6dec9720b", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10209"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10209"], "publishedAtTs": "1780886530", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A greatsword that took Hongshan Swordmancers ten years to design and produce. Its dimensions are well-proportioned and it strikes with incredible power and ferocity. It is an exemplary piece of heavy weaponry."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "1000", "name": "Phantom Pain", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260606/2452982252316/6a22facb337a1106819611ac_db193eac.png", "name": "Phantom Pain", "description": null, "associate": {"id": "aff6c929663f27d14cf618acb0304405", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10209"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10209"], "publishedAtTs": "1780886525", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A prototype produced by Portable Æthertech Labs. The body of the blade is constructed with novel materials that give this weapon its exceptionally light weight without compromising its potential for destruction."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "999", "name": "Beacon of Duty", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260608/3864465401225/6a265984337a11068196219b_3eac6ad0.png", "name": "Beacon of Duty", "description": null, "associate": {"id": "eaa20a24296b84e8be8f8947170a02ec", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10212"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10212"], "publishedAtTs": "1780886521", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "An old weapon from the Northmarch Support Hub with extremely poor handling. But it also features an incredible capacity for damage. Its massive weight might make it unpopular with most, but strong wielders who enjoy powerful, over-the-top moves rate it rather positively."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "839", "name": "Lone Barge", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260418/7192618399447/69e32f8ffcc548f615ca56f5_3eac6ad0.png", "name": "Lone Barge", "description": null, "associate": {"id": "6c5d4ace32ad675ad62d3dbed2ce36fe", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10211"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10211"], "publishedAtTs": "1776654217", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities.\r\nAn Arts Unit developed by Hongshan Swordmancers. The weapon features a bold integration of novel Xiranite amalgams. Though the materials offer excellent performance that greatly improves casting efficiency, this Arts Unit can be quite challenging to use.\r"}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "840", "name": "Flickers in the Mist", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260418/7192618399447/69e3301bfcc548f615ca56f8_3eac6ad0.png", "name": "Flickers in the Mist", "description": null, "associate": {"id": "52e6d7099938bdd6136355c9038a07e0", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10211"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10211"], "publishedAtTs": "1776654212", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities.\r\nA classical product of Endfield Industries. Numerous units were deployed during the Polar Expedition. These Arts Units have conspicuous golden-yellow coating, making them clearly visible, even in heavy snowstorms."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "733", "name": "Lupine Scarlet", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260329/6743194780021/69c8ca4a04c7f0cc11675db0_2f76db19.png", "name": "Lupine Scarlet", "description": null, "associate": {"id": "1289c1b863eb801da6e4b618f4625227", "name": "", "type": "weapon", "dotType": ""}, "dotType": "", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10210"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10210"], "publishedAtTs": "1774845280", "caption": [{"kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "A popular sword produced by RAYTHEAN Industries. Plenty have been smuggled to regions outside the Civilization Band as they proved to be quite the catch amongst the Landbreakers."}}, {"kind": "text", "text": {"text": " "}}, {"kind": "text", "text": {"text": "Many users also furnish them with specialized modifications."}}, {"kind": "text", "text": {"text": " "}}]}, {"itemId": "732", "name": "Brigand's Calling", "lang": "en", "brief": {"cover": "https://static.skport.com/image/rm42wiki/20260313/6743194780021/69b3b9c0c58d404e53cf3edd_3eac6ad0.png", "name": "Brigand's Calling", "description": null, "associate": {"id": "ce921de1dd2c99cd8822239db886c08e", "name": "", "type": "weapon", "dotType": ""}, "dotType": "label_type_up", "subTypeList": [{"subTypeId": "10000", "value": "10006"}, {"subTypeId": "10207", "value": "10208"}], "composite": null, "disableCoverShowInDetail": false, "redirectLink": "", "redirectLinkMobile": ""}, "status": 2, "tagIds": ["10006", "10208"], "publishedAtTs": "1773475805", "caption": [{"color": "light_text_secondary", "kind": "text", "text": {"text": "A weapon equipped by Endfield operators to significantly boost their combat capabilities."}}, {"kind": "text", "text": {"text": " "}}, {"color": "light_text_secondary", "kind": "text", "text": {"text": "Guns developed by Hongshan Swordmancers. Constructed using durable and reliable materials with simple designs, they are also light and easy to carry around. Very useful in all sorts of complex environments and situations."}}, {"kind": "text", "text": {"text": " "}}]}], "filterTagTree": [{"id": "10000", "children": [{"id": "10003", "children": [], "name": "3★", "type": 2, "value": "rarity_3", "hide": false}, {"id": "10004", "children": [], "name": "4★", "type": 2, "value": "rarity_4", "hide": false}, {"id": "10005", "children": [], "name": "5★", "type": 2, "value": "rarity_5", "hide": false}, {"id": "10006", "children": [], "name": "6★", "type": 2, "value": "rarity_6", "hide": false}], "name": "Rarity", "type": 2, "value": "", "hide": false}, {"id": "10207", "children": [{"id": "10210", "children": [], "name": "Sword", "type": 1, "value": "", "hide": false}, {"id": "10209", "children": [], "name": "Greatsword", "type": 1, "value": "", "hide": false}, {"id": "10208", "children": [], "name": "Handcannon", "type": 1, "value": "", "hide": false}, {"id": "10211", "children": [], "name": "Arts Unit", "type": 1, "value": "", "hide": false}, {"id": "10212", "children": [], "name": "Polearm", "type": 1, "value": "", "hide": false}], "name": "Type", "type": 1, "value": "", "hide": false}]}]}]}}